# Optional because the original NASA code is supplied separately.
function(ifdda_configure_mishchenko option_name)
    set(_default ON)
    foreach(_f ampld.lp.f ampld.par.f lpd.f)
        if(NOT EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/NASA/${_f}")
            set(_default OFF)
        endif()
    endforeach()
    option(${option_name} "Build the OpenMP + CUDA FP64 Mishchenko reference" ${_default})
    if(${option_name})
        set(IFDDA_MISHCHENKO_BUILD_STANDALONE OFF)
        set(IFDDA_MISHCHENKO_ENABLE_CUDA ON)
        add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/mishchenko_reference" EXCLUDE_FROM_ALL)
    endif()
endfunction()
function(ifdda_attach_windows_references directory)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_target IN LISTS _targets)
        get_target_property(_type "${_target}" TYPE)
        if(_type STREQUAL "EXECUTABLE" AND _target MATCHES "^test_")
            ifdda_mishchenko_attach("${_target}")
        endif()
    endforeach()
    get_property(_subdirs DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_subdir IN LISTS _subdirs)
        if(NOT _subdir MATCHES "/(Mishchenko|Scattnlay)$")
            ifdda_attach_windows_references("${_subdir}")
        endif()
    endforeach()
endfunction()
